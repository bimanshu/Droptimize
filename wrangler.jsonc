// Cloudflare deploy for the website in website/. Only the films go through the Worker.
{
  "name": "droptimize",
  "compatibility_date": "2026-11-01",
  "main": "scripts/website-worker.js",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/*.mp4"]
  }
}
